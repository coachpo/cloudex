# Generate once with: openssl rand -hex 32
CLOUDEX_MASTER_KEY=
CLOUDEX_PORT=3000
CLOUDEX_ORIGIN=http://localhost:3000

# Optional custom HTTPS origin reachable from work containers. An HTTPS console origin is reused when set.
# With a loopback HTTP console, default Compose provides a private HTTP gateway for the local Host.
CLOUDEX_GATEWAY_ORIGIN=
# Publish the shared OAuth callback on the control-plane host's loopback. 1457 is the alternate port.
CLOUDEX_OAUTH_CALLBACK_PORT=1455

# Tag used only when building the workspace image with Compose.
CLOUDEX_WORKSPACE_IMAGE=cloudex/workspace:codex-0.172.0
# The SSH Gateway stays on loopback by default. For LAN or VPN access,
# select a specific private IPv4 address on the Docker host.
CLOUDEX_SSH_BIND=127.0.0.1
CLOUDEX_SSH_PORT=2222
CLOUDEX_SSH_NETWORK=cloudex-workspaces
# The Agent listener stays on loopback unless a private address is selected.
CLOUDEX_AGENT_BIND=127.0.0.1
CLOUDEX_AGENT_PORT=9443
